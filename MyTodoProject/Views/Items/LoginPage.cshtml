<div class="login-container">
    <div class="login-box">
        <div class="login-card">
            <form class="login-form">
                <div class="form-group">
                    <label htmlFor="username" class="form-label">
                        Username
                    </label>
                    <input id="username"
                           type="text"
                           name="username"
                           class="form-input"
                           required />
                </div>

                <div class="form-group">
                    <label htmlFor="password" class="form-label">
                        Password
                    </label>
                    <input id="password"
                           type="password"
                           name="password"
                           class="form-input"
                           required />
                </div>

                <button type="submit" class="login-button">
                    Logins
                </button>
            </form>
        </div>
    </div>
</div>